{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/decision.schema.json",
  "title": "Wingman decision metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "namespaces",
    "status",
    "date",
    "authority",
    "scope",
    "approval_evidence",
    "supersedes",
    "superseded_by"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "namespaces": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["proposed", "accepted", "superseded"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "authority": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "approval_evidence": {"type": "string", "minLength": 1},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "superseded_by": {"type": ["string", "null"]}
  }
}
