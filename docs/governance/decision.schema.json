{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/decision.schema.json",
  "title": "Wingman decision metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "namespaces",
    "status",
    "date",
    "authority",
    "scope",
    "approval_evidence",
    "supersedes",
    "superseded_by"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "namespaces": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "status": {"enum": ["proposed", "accepted", "superseded"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "authority": {"const": "Maverick"},
    "scope": {"type": "string", "minLength": 1},
    "approval_evidence": {"type": "string", "minLength": 1},
    "ratified_missions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "implementation_commits"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+(?:/[a-z0-9-]+)+$"},
          "implementation_commits": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
          }
        }
      }
    },
    "supersedes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}, "uniqueItems": true},
    "superseded_by": {"type": ["string", "null"], "pattern": "^[A-Z]+-[0-9]{3}$"}
  }
}
