{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/mission.schema.json",
  "title": "Wingman mission metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "legacy_aliases",
    "title",
    "call_sign",
    "namespace",
    "lifecycle",
    "priority",
    "portfolio_primary",
    "authorization_gate",
    "approval_evidence",
    "baseline_commit",
    "implementation_commits",
    "pushed",
    "merged",
    "official_decisions",
    "next_gate",
    "supersedes",
    "superseded_by",
    "paused",
    "cancelled",
    "capability_health"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+(?:/[a-z0-9-]+)+$"},
    "legacy_aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "title": {"type": "string", "minLength": 1},
    "call_sign": {"type": ["string", "null"]},
    "namespace": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["draft", "active", "completed", "archived"]},
    "priority": {"type": "string", "minLength": 1},
    "portfolio_primary": {"type": "boolean"},
    "authorization_gate": {"type": "string", "minLength": 1},
    "approval_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "baseline_commit": {"type": ["string", "null"]},
    "implementation_commits": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "pushed": {"type": "boolean"},
    "merged": {"type": "boolean"},
    "official_decisions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_session", "branch", "worktree", "writable_scope", "state", "next_gate"],
      "properties": {
        "owner_session": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "writable_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "state": {"type": "string", "minLength": 1},
        "next_gate": {"type": "string", "minLength": 1}
      }
    },
    "next_gate": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]},
    "paused": {"type": "boolean"},
    "cancelled": {"type": "boolean"},
    "capability_health": {"type": "string", "minLength": 1}
  }
}
