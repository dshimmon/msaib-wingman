{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wingman://ledger/authorization-receipt-v1",
  "title": "Ledger Transition Authorization Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "canary",
    "asserted_authority",
    "manifest",
    "run_id",
    "expires_at",
    "permitted_operation",
    "target",
    "backup_destination",
    "code_identity",
    "migration_plan_sha256",
    "command",
    "authorization_text_sha256",
    "single_use",
    "automatic_retry_permitted",
    "state",
    "trust_boundary",
    "receipt_id"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "ledger_transition_authorization_receipt"},
    "canary": {"const": "CANOPY-7C2F-ATLAS"},
    "asserted_authority": {"const": "Maverick"},
    "manifest": {"type": "object"},
    "run_id": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "permitted_operation": {"enum": ["migrate", "restore", "rollback"]},
    "target": {"type": "object"},
    "backup_destination": {"type": "string"},
    "code_identity": {"type": "object"},
    "migration_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"type": "object"},
    "authorization_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "single_use": {"const": true},
    "automatic_retry_permitted": {"const": false},
    "state": {"const": "unused"},
    "trust_boundary": {"type": "string", "minLength": 1},
    "receipt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
