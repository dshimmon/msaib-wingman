{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wingman://ledger/transition-manifest-v1",
  "title": "Ledger Transition Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "canary",
    "authority",
    "run_id",
    "expires_at",
    "permitted_operation",
    "target",
    "backup_destination",
    "code_identity",
    "migration_plan_sha256",
    "command",
    "receipt_path",
    "caller_supplied_sql",
    "caller_supplied_migration_selection",
    "automatic_retry_permitted",
    "manifest_id"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "ledger_transition_manifest"},
    "canary": {"const": "CANOPY-7C2F-ATLAS"},
    "authority": {"const": "Maverick"},
    "run_id": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "permitted_operation": {"enum": ["migrate", "restore", "rollback"]},
    "target": {"type": "object"},
    "backup_destination": {"type": "string", "minLength": 1},
    "code_identity": {"type": "object"},
    "migration_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"type": "object"},
    "receipt_path": {"type": "string", "minLength": 1},
    "caller_supplied_sql": {"const": false},
    "caller_supplied_migration_selection": {"const": false},
    "automatic_retry_permitted": {"const": false},
    "manifest_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
