{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wingman-flightline-engineer-report-v1",
  "title": "Wingman Development Engineer Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canary",
    "role",
    "mission",
    "baseline_commit",
    "authority_state",
    "outcome",
    "starting_state",
    "decisions",
    "changed_files",
    "validation",
    "acceptance_criteria",
    "compatibility_surfaces",
    "errors_and_scope_decisions",
    "risks_and_deferred_work",
    "final_repository_state",
    "prohibited_action_confirmation",
    "frozen_artifacts",
    "auditor_focus"
  ],
  "properties": {
    "canary": {"const": "CANOPY-7C2F-ATLAS"},
    "role": {"const": "development-engineer"},
    "mission": {"type": "object"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authority_state": {"const": "NO_COMMIT_AUTHORITY"},
    "outcome": {"type": "string"},
    "starting_state": {"type": "object"},
    "decisions": {"type": "array"},
    "changed_files": {"type": "array"},
    "validation": {"type": "array"},
    "acceptance_criteria": {"type": "array"},
    "compatibility_surfaces": {"type": "array"},
    "errors_and_scope_decisions": {"type": "array"},
    "risks_and_deferred_work": {"type": "array"},
    "final_repository_state": {"type": "object"},
    "prohibited_action_confirmation": {"type": "object"},
    "frozen_artifacts": {"type": "array"},
    "auditor_focus": {"type": "array"}
  }
}
