{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/lso/execution-report-v1.schema.json",
  "title": "LSO closeout execution report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canary", "report_id", "plan_id", "receipt_id", "status", "started_at", "completed_at", "completed_actions", "failed_action", "error", "implementation_commit", "closeout_commit", "remote_branch_head", "remote_target_head", "mission_completed", "authority_statement"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canary": {"const": "CANOPY-7C2F-ATLAS"},
    "report_id": {"$ref": "#/$defs/sha256"},
    "plan_id": {"$ref": "#/$defs/sha256"},
    "receipt_id": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["COMPLETE", "PARTIAL", "FAILED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "completed_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "failed_action": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]},
    "implementation_commit": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
    "closeout_commit": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
    "remote_branch_head": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
    "remote_target_head": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
    "mission_completed": {"type": "boolean"},
    "authority_statement": {"const": "COMPLETE means the exact authorized closeout was committed, published, recorded, and remotely verified; it does not authorize or report a live operation."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
