{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/lso/authorization-receipt-v1.schema.json",
  "title": "LSO package-bound closeout authorization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canary", "receipt_id", "plan_id", "plan_sha256", "authorization_text_sha256", "authorization_text_size", "asserted_authority", "allowed_actions", "single_use", "created_at", "expires_at", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canary": {"const": "CANOPY-7C2F-ATLAS"},
    "receipt_id": {"$ref": "#/$defs/sha256"},
    "plan_id": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_text_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_text_size": {"type": "integer", "minimum": 1},
    "asserted_authority": {"const": "Maverick"},
    "allowed_actions": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "string"}, "uniqueItems": true},
    "single_use": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authority_boundary": {"const": "The authenticated Mission Control interaction and trusted local operating-system account are the v1 authorization boundary; this receipt is tamper-evident, not independent identity proof."}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
