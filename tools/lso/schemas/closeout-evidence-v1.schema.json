{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/lso/closeout-evidence-v1.schema.json",
  "title": "LSO closeout validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canary", "required_checks_complete", "commands", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canary": {"const": "CANOPY-7C2F-ATLAS"},
    "required_checks_complete": {"const": true},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "scope", "result", "exit_code", "summary"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "result": {"const": "PASS"},
          "exit_code": {"const": 0},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
