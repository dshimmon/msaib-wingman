{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/crew-chief/pool-manifest-v1.schema.json",
  "title": "Wingman Crew Chief Pool Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "jobs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "audit_envelope"],
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "audit_envelope": {"type": "string", "minLength": 1},
          "workspace": {"type": "string", "minLength": 1},
          "allow_fresh_session_fallback": {"type": "boolean"}
        }
      }
    }
  }
}
