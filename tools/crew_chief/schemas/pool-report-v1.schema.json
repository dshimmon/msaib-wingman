{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/crew-chief/pool-report-v1.schema.json",
  "title": "Wingman Crew Chief Pool Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest",
    "output_root",
    "report_path",
    "execute_requested",
    "requested_max_concurrency",
    "effective_max_concurrency",
    "maximum_observed_concurrency",
    "queue_policy",
    "failure_policy",
    "automatic_retries",
    "pool_started_at",
    "pool_completed_at",
    "overall_status",
    "totals",
    "jobs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest": {"$ref": "#/$defs/binding"},
    "output_root": {"type": "string", "minLength": 1},
    "report_path": {"type": "string", "minLength": 1},
    "execute_requested": {"type": "boolean"},
    "requested_max_concurrency": {"type": "integer", "minimum": 1, "maximum": 4},
    "effective_max_concurrency": {"type": "integer", "minimum": 1, "maximum": 4},
    "maximum_observed_concurrency": {"type": "integer", "minimum": 0, "maximum": 4},
    "queue_policy": {"const": "bounded-input-order"},
    "failure_policy": {"const": "continue-independent-jobs"},
    "automatic_retries": {"const": 0},
    "pool_started_at": {"type": "string", "format": "date-time"},
    "pool_completed_at": {"type": "string", "format": "date-time"},
    "overall_status": {"enum": ["PREPARED", "PASS", "FAIL"]},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobs",
        "queued",
        "running",
        "completed",
        "failed",
        "verdict_pass",
        "verdict_pass_with_advisories",
        "verdict_fail",
        "verdict_blocked",
        "verdict_unavailable"
      ],
      "properties": {
        "jobs": {"type": "integer", "minimum": 1},
        "queued": {"type": "integer", "minimum": 0},
        "running": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "verdict_pass": {"type": "integer", "minimum": 0},
        "verdict_pass_with_advisories": {"type": "integer", "minimum": 0},
        "verdict_fail": {"type": "integer", "minimum": 0},
        "verdict_blocked": {"type": "integer", "minimum": 0},
        "verdict_unavailable": {"type": "integer", "minimum": 0}
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/job"}
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "diagnostic"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "diagnostic": {"type": "string", "minLength": 1}
      }
    },
    "job_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope", "invocation", "report", "run_record"],
      "properties": {
        "envelope": {"$ref": "#/$defs/binding"},
        "invocation": {
          "oneOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]
        },
        "report": {
          "oneOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]
        },
        "run_record": {
          "oneOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "input_index",
        "audit_id",
        "envelope_id",
        "envelope_path",
        "workspace",
        "execution_mode",
        "state",
        "attempts",
        "verdict",
        "bindings",
        "errors",
        "started_at",
        "completed_at",
        "token_count"
      ],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "input_index": {"type": "integer", "minimum": 0},
        "audit_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "envelope_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "envelope_path": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "minLength": 1},
        "execution_mode": {
          "type": ["string", "null"],
          "enum": ["custom-agent", "fresh-session-fallback", null]
        },
        "state": {"enum": ["QUEUED", "RUNNING", "COMPLETED", "FAILED"]},
        "attempts": {"type": "integer", "minimum": 0, "maximum": 1},
        "verdict": {
          "type": ["string", "null"],
          "enum": ["PASS", "PASS_WITH_ADVISORIES", "FAIL", "BLOCKED", null]
        },
        "bindings": {"$ref": "#/$defs/job_bindings"},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "token_count": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
