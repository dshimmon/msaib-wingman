{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/crew-chief/finding-v1.schema.json",
  "title": "Wingman Crew Chief Finding v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "line_start", "line_end"],
      "properties": {
        "kind": {"const": "source"},
        "path": {"type": "string", "minLength": 1},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "artifactEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact", "reference"],
      "properties": {
        "kind": {"const": "artifact"},
        "artifact": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1}
      }
    }
  },
  "required": [
    "finding_id",
    "severity",
    "blocking",
    "category",
    "evidence",
    "why_it_matters",
    "action_kind",
    "action"
  ],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^CC-[0-9]{4}$"},
    "severity": {
      "enum": ["critical", "high", "medium", "low", "advisory"]
    },
    "blocking": {"type": "boolean"},
    "blocking_rationale": {"type": "string", "minLength": 1},
    "category": {
      "enum": [
        "scope",
        "architecture",
        "correctness",
        "tests",
        "documentation",
        "dependencies",
        "compatibility",
        "unrequested_changes",
        "completion_claims",
        "maintainability",
        "security",
        "governance",
        "evidence_controls"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/sourceEvidence"},
          {"$ref": "#/$defs/artifactEvidence"}
        ]
      }
    },
    "why_it_matters": {"type": "string", "minLength": 1},
    "action_kind": {"enum": ["required", "recommended"]},
    "action": {"type": "string", "minLength": 1}
  }
}
