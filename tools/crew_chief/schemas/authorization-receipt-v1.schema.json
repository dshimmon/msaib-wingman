{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/crew-chief/authorization-receipt-v1.schema.json",
  "title": "Wingman Package-Bound Bootstrap Authorization Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "canary",
    "authority",
    "subject",
    "authorization",
    "authorized_at",
    "expires_at",
    "receipt_id"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "receipt_type": {
      "type": "string",
      "const": "maverick_package_authorization"
    },
    "canary": {"type": "string", "const": "CANOPY-7C2F-ATLAS"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "authorization_text_sha256"],
      "properties": {
        "identity": {"type": "string", "const": "Maverick"},
        "authorization_text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_commit",
        "package",
        "service_schema",
        "audit_id",
        "envelope_id",
        "package_expires_at"
      ],
      "properties": {
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package": {"$ref": "#/$defs/binding"},
        "service_schema": {"$ref": "#/$defs/binding"},
        "audit_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "envelope_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "package_expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinary_bootstrap_invocations",
        "conditional_crew_chief_fixture_audits",
        "automatic_retries_permitted"
      ],
      "properties": {
        "ordinary_bootstrap_invocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "conditional_crew_chief_fixture_audits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "automatic_retries_permitted": {"type": "boolean", "const": false}
      }
    },
    "authorized_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "receipt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "sha256"],
      "properties": {
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
