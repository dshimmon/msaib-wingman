{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/crew-chief/audit-envelope-v1.schema.json",
  "title": "Wingman Crew Chief Audit Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      }
    }
  },
  "required": [
    "schema_version",
    "canary",
    "audit_id",
    "envelope_id",
    "repository",
    "mission",
    "subject",
    "git_state",
    "risk_profile",
    "manifest",
    "created_at",
    "expires_at",
    "envelope_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canary": {"const": "CANOPY-7C2F-ATLAS"},
    "audit_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "envelope_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "repository_root", "git_common_dir", "root_commits"],
      "properties": {
        "repository_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "repository_root": {"type": "string", "minLength": 1},
        "git_common_dir": {"type": "string", "minLength": 1},
        "root_commits": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_path", "frozen"],
      "properties": {
        "repository_path": {"type": "string", "minLength": 1},
        "frozen": {"$ref": "#/$defs/binding"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "base_commit", "head_commit", "authorized_untracked"],
      "properties": {
        "mode": {"enum": ["committed-range", "working-tree"]},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "authorized_untracked": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "git_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "branch",
        "status_porcelain_v1",
        "staged_diff_sha256",
        "unstaged_diff_sha256",
        "untracked_paths",
        "state_hash"
      ],
      "properties": {
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "branch": {"type": "string", "minLength": 1},
        "status_porcelain_v1": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "staged_diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "unstaged_diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "untracked_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "risk_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "justification", "required_focus"],
      "properties": {
        "name": {"enum": ["standard", "deep", "exempt"]},
        "justification": {"type": "string"},
        "required_focus": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "manifest": {"$ref": "#/$defs/binding"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "envelope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
