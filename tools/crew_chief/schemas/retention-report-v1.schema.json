{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/crew-chief/retention-report-v1.schema.json",
  "title": "Wingman Crew Chief Retained Report Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "report_kind",
    "state",
    "bundle_path",
    "created_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
    },
    "report_kind": {"enum": ["audit", "pool"]},
    "state": {"enum": ["queued", "running", "completed"]},
    "bundle_path": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
