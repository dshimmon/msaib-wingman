{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/crew-chief/report-v1.schema.json",
  "title": "Wingman Crew Chief Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canary",
    "role",
    "audit_id",
    "envelope_id",
    "reviewer_context",
    "verdict",
    "blocked_reasons",
    "findings",
    "audit_scope",
    "validation_evidence",
    "generated_at",
    "authority_statement"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canary": {"const": "CANOPY-7C2F-ATLAS"},
    "role": {"const": "crew_chief"},
    "audit_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "envelope_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_session",
        "read_only",
        "implementation_conversation_inherited",
        "live_network_tools_enabled"
      ],
      "properties": {
        "fresh_session": {"const": true},
        "read_only": {"const": true},
        "implementation_conversation_inherited": {"const": false},
        "live_network_tools_enabled": {"const": false}
      }
    },
    "verdict": {
      "enum": ["PASS", "PASS_WITH_ADVISORIES", "FAIL", "BLOCKED"]
    },
    "blocked_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "https://wingman.local/schemas/crew-chief/finding-v1.schema.json"
      }
    },
    "audit_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validation_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "authority_statement": {
      "const": "Crew Chief is advisory; Maverick retains final authority."
    }
  }
}
