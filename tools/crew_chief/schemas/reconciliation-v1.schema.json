{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/crew-chief/reconciliation-v1.schema.json",
  "title": "Wingman Crew Chief Reconciliation Package v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "disposition", "summary"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^CC-[0-9]{4}$"},
        "disposition": {
          "enum": [
            "resolved",
            "disputed_with_evidence",
            "escalated_to_maverick"
          ]
        },
        "summary": {"type": "string", "minLength": 1},
        "correction_evidence": {"$ref": "#/$defs/evidence"},
        "validation_results": {"$ref": "#/$defs/evidence"},
        "counter_evidence": {"$ref": "#/$defs/evidence"},
        "reasoning": {"type": "string", "minLength": 1},
        "unresolved_issue": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "decision_requested": {"type": "string", "minLength": 1}
      }
    }
  },
  "required": [
    "schema_version",
    "canary",
    "audit_id",
    "envelope_id",
    "report_hash",
    "dispositions",
    "reconciliation_complete",
    "approval_ready",
    "generated_at",
    "authority_statement",
    "package_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canary": {"const": "CANOPY-7C2F-ATLAS"},
    "audit_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "envelope_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dispositions": {
      "type": "array",
      "items": {"$ref": "#/$defs/disposition"}
    },
    "reconciliation_complete": {"type": "boolean"},
    "approval_ready": {"type": "boolean"},
    "generated_at": {"type": "string", "format": "date-time"},
    "authority_statement": {
      "const": "Maverick retains final approval and mission-completion authority."
    },
    "package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
