{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingman.local/schemas/crew-chief/retention-state-v1.schema.json",
  "title": "Wingman Crew Chief Retention State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "retention_days",
    "max_retained_reports",
    "current_retained_count",
    "last_cleanup_time",
    "removed_during_last_cleanup"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "retention_days": {"type": "integer", "minimum": 0},
    "max_retained_reports": {"type": "integer", "minimum": 1},
    "current_retained_count": {"type": "integer", "minimum": 0},
    "last_cleanup_time": {"type": "string", "format": "date-time"},
    "removed_during_last_cleanup": {"type": "integer", "minimum": 0}
  }
}
